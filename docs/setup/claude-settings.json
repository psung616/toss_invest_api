{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew test)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew check)",
      "Bash(./gradlew check *)",
      "Bash(./gradlew build)",
      "Bash(./gradlew build *)",
      "Bash(./gradlew bootJar)",
      "Bash(./gradlew spotlessApply)",
      "Bash(./gradlew spotlessCheck)",
      "Bash(./gradlew dependencies *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(java -jar *)",
      "Bash(./gradlew bootRun *)",
      "Bash(./gradlew bootRun)",
      "Bash(./gradlew liveTest *)",
      "Bash(./gradlew liveTest)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-docs.mjs\"",
            "timeout": 15,
            "statusMessage": "필수 문서 확인 중..."
          }
        ]
      }
    ]
  }
}
