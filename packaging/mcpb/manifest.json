{
  "manifest_version": "0.3",
  "name": "tossinvest-mcp",
  "display_name": "토스증권 (비공식)",
  "version": "@VERSION@",
  "description": "토스증권 Open API 로컬 MCP 서버 (비공식). 시세·매수가능금액·주문내역 조회, 안전장치가 있는 주문.",
  "long_description": "토스증권과 무관한 비공식 오픈소스입니다. 키는 Claude Desktop 이 OS 자격 증명 저장소에 보관하고, 서버는 이 PC 에서만 실행되며 토스증권 서버와만 통신합니다. 주문 기능은 기본으로 꺼져 있고, 켜더라도 모의 주문(DRY RUN)이 기본입니다. 투자 손실의 책임은 사용자 본인에게 있습니다.",
  "author": {
    "name": "psung616",
    "url": "https://github.com/psung616"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/psung616/toss_invest_api"
  },
  "homepage": "https://github.com/psung616/toss_invest_api",
  "license": "MIT",
  "keywords": ["toss", "stock", "trading", "korea"],
  "server": {
    "type": "binary",
    "entry_point": "server/tossinvest-mcp/tossinvest-mcp.exe",
    "mcp_config": {
      "command": "${__dirname}/server/tossinvest-mcp/tossinvest-mcp.exe",
      "args": ["serve"],
      "env": {
        "TOSSINVEST_CLIENT_ID": "${user_config.client_id}",
        "TOSSINVEST_CLIENT_SECRET": "${user_config.client_secret}",
        "TOSSINVEST_ENABLE_ORDERS": "${user_config.enable_orders}",
        "TOSSINVEST_DRY_RUN": "${user_config.dry_run}",
        "TOSSINVEST_ALLOWED_SYMBOLS": "${user_config.allowed_symbols}",
        "TOSSINVEST_MAX_ORDER_KRW": "${user_config.max_order_krw}"
      }
    }
  },
  "tools": [
    { "name": "get_quote", "description": "현재가 조회" },
    { "name": "get_buying_power", "description": "매수 가능 금액 조회" },
    { "name": "list_orders", "description": "주문 내역 조회" },
    { "name": "preview_order", "description": "주문 미리보기 (주문 기능을 켠 경우)" },
    { "name": "place_order", "description": "미리보기한 주문 실행 (주문 기능을 켠 경우)" }
  ],
  "compatibility": {
    "platforms": ["win32"]
  },
  "user_config": {
    "client_id": {
      "type": "string",
      "title": "Client ID",
      "description": "토스증권 PC 웹(WTS) > 설정 > Open API 에서 발급한 Client ID",
      "sensitive": true,
      "required": true
    },
    "client_secret": {
      "type": "string",
      "title": "Client Secret",
      "description": "토스증권 PC 웹(WTS) > 설정 > Open API 에서 발급한 Client Secret",
      "sensitive": true,
      "required": true
    },
    "enable_orders": {
      "type": "boolean",
      "title": "주문 기능 사용",
      "description": "끄면 조회만 할 수 있습니다.",
      "default": false,
      "required": false
    },
    "dry_run": {
      "type": "boolean",
      "title": "모의 주문 (DRY RUN)",
      "description": "켜 두면 실제 주문을 보내지 않고 기록만 남깁니다.",
      "default": true,
      "required": false
    },
    "allowed_symbols": {
      "type": "string",
      "title": "주문 허용 종목",
      "description": "쉼표로 구분한 종목 코드 (예: 005930,000660). 비워 두면 주문할 수 없습니다.",
      "default": "",
      "required": false
    },
    "max_order_krw": {
      "type": "number",
      "title": "1회 최대 주문 금액 (원)",
      "description": "이 금액을 넘는 주문은 거부됩니다.",
      "default": 100000,
      "min": 1000,
      "max": 99999999,
      "required": false
    }
  }
}
